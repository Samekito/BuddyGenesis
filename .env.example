# Copy to .env and fill in. Every value here is free to obtain.

# Signs login sessions. Generate with: .venv/Scripts/chainlit create-secret
CHAINLIT_AUTH_SECRET=

# LLM — free key from https://console.groq.com/keys (no card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Admin password login. Leave either empty to disable it. The username must not be an email address.
BUDDY_ADMIN_USERNAME=
BUDDY_ADMIN_PASSWORD=

# Google login (optional). Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: <app url>/auth/oauth/google/callback
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# Public URL of the app when hosted, e.g. https://soc-buddy.onrender.com (no trailing slash needed).
# Needed for the Google redirect, and trusted as the origin of sign-in and sign-up forms.
CHAINLIT_URL=

# Chat history. Empty = local SQLite file at data/chainlit.db.
# Hosted: a Postgres URL, e.g. from https://neon.com free tier (postgresql://...?sslmode=require).
# Postgres always uses TLS with certificate checks; add ?sslmode=disable only for a local dev server.
# On Render the app refuses to start without a Postgres URL (its disk is wiped on spin-down).
DATABASE_URL=

# Account emails (sign-up confirmation, password reset). Free Brevo account, no card:
# https://www.brevo.com > SMTP & API > API keys. Without a key, sign-up and password reset are off.
# EMAIL_FROM must be a sender address you have added and verified in Brevo (Senders & IPs).
# CHAINLIT_URL (above) is required with a key, e.g. http://localhost:8000 when testing locally.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=SOC Buddy

# Local development only (refused on Render): write emails as text files here instead of sending
# them, e.g. data/outbox (inside the git-ignored data/ folder). Leave empty when BREVO_API_KEY is set.
EMAIL_OUTBOX_DIR=
